# Copy this file to .env and fill it in:  cp .env.example .env
# Everything is optional except the weather key (only needed for weather updates).

# --- Weather -------------------------------------------------------------------
# Free key: https://home.openweathermap.org/api_keys  (new keys take up to ~2 hours to activate)
OPENWEATHER_API_KEY=
# Used when you don't name a city. Format: City,State,Country for the US, City,Country elsewhere
DEFAULT_CITY=Lawrence,KS,US
# imperial (F, mph) or metric (C, m/s)
UNITS=imperial

# --- Personality ---------------------------------------------------------------
CREATOR_NAME=Neeraj
# How Jarvis addresses you; leave empty to turn it off
HONORIFIC=sir
WAKE_WORD=jarvis

# --- Speech-to-text ------------------------------------------------------------
# google = online and accurate; vosk = offline (run: python scripts/download_vosk.py)
STT_ENGINE=google
# Spot the wake word offline with Vosk and use Google only for the command itself:
# WAKE_ENGINE=vosk
# Pick a specific microphone (list them with: python main.py --list-mics)
# MIC_DEVICE_INDEX=
# Seconds Jarvis keeps listening for a follow-up after answering (0 = always need the wake word)
FOLLOW_UP_SECONDS=6

# --- Text-to-speech ------------------------------------------------------------
# auto (macOS: say, elsewhere: pyttsx3) | say | pyttsx3 | gtts | print
TTS_ENGINE=auto
# British English voice. If your Mac doesn't have it, download it in System Settings >
# Accessibility > Read & Speak (Spoken Content on older macOS) > (i) next to System voice,
# pick another voice from: say -v '?'   ...or leave this empty for your Mac's default voice.
TTS_VOICE=Daniel
TTS_RATE=185

# --- Models ----------------------------------------------------------------------
# torch (PyTorch, MPS on Apple Silicon) or tf (TensorFlow/Keras - see requirements-tf.txt)
INTENT_BACKEND=torch
# auto | mps | cpu
TORCH_DEVICE=auto
# Below this confidence a command is treated as small talk
CONFIDENCE_THRESHOLD=0.4
# Use the fine-tuned DistilGPT-2 in models/chat for small talk when it exists
CHAT_ENABLED=true
